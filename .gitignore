node_modules
dist
dist-electron
tmp
*.log
*.bun-build

# 子智能体的长报告自动落盘目录（store.ts 自动生成，属运行时产物，不入库）
.ada/subagent-outputs/

# Rust 编译产物
target/
agent_core/target/
cargo_target_ada/

# SSR 前端插件的历史停用状态文件（现行状态在 ~/.a-da/web-ui-state.json）
.ssr-h-state.json

# 工具/编辑器的本地状态目录（不是项目内容）
.commandcode/
.workbuddy/
.zcode/

# 根目录的包管理器锁文件：本地生成物，不入库。
# 仓库**真正跟踪**的锁文件只有 `Cargo.lock`（2026-10：`desktop-ui/` 移除后，
# 前端依赖锁也一并消失）。
# 下面三条**锚定根目录**，不要写成不带 `/` 的 `package-lock.json`。
/bun.lock
/bun.lockb
/package-lock.json

# 用户本地配置临时目录
.a-da/

# 插件库平台运行时（SQLite 库 + 上传的 ZIP 资产）
/data/

