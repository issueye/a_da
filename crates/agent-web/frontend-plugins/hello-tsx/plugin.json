{
  "id": "hello-tsx",
  "name": "Hello TSX",
  "version": "0.2.0",
  "description": "运行时 TSX 插件：OXC + Boa 在服务端执行，VNode 交给 Rust 组件库渲染；自带 JSON API（/ext/hello-tsx/api/*）。",
  "assets": "static",
  "styles": ["hello.css"],
  "scripts": ["hello.js"],
  "nav": [{ "label": "Hello TSX", "slug": "hello" }],
  "pages": [{ "slug": "hello", "title": "Hello TSX", "template": "page.tsx" }],
  "dashboard": "dashboard.tsx",
  "api": [
    { "method": "get", "path": "info", "template": "api/info.tsx" },
    { "method": "post", "path": "echo", "template": "api/echo.tsx" }
  ]
}
