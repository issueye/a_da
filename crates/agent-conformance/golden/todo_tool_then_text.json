{
  "name": "todo_tool_then_text",
  "description": "一次真实工具调用（core 工具包的 todo）后收尾：验证 tool.started/finished 进事件序列",
  "spec": {
    "archetype": "coding",
    "capabilities": {
      "images": false,
      "rollback": false,
      "streaming": true,
      "subagents": false
    },
    "id": "ada-golden",
    "identity": {
      "locale": "zh-CN",
      "name": "夹具产品",
      "persona": "system.md"
    },
    "policies": {
      "maxSteps": 8,
      "parallelTools": 1,
      "toolTimeoutSec": 30
    },
    "toolkits": [
      "core"
    ]
  },
  "threadId": "golden_todo_tool",
  "provider": {
    "id": "golden",
    "name": "golden",
    "protocol": "openai_chat",
    "baseUrl": "http://localhost",
    "apiKey": "k",
    "model": "m"
  },
  "script": [
    [
      {
        "type": "tool_call",
        "call": {
          "id": "call_todo_1",
          "name": "todo",
          "args": "{\"action\":\"set\",\"items\":[{\"id\":\"1\",\"title\":\"写夹具\",\"done\":false}]}"
        }
      },
      {
        "type": "done",
        "stopReason": "tool_calls"
      }
    ],
    [
      {
        "type": "text",
        "text": "待办已记录。"
      },
      {
        "type": "done",
        "stopReason": "stop"
      }
    ]
  ],
  "expected": {
    "stepsTaken": 2,
    "stopReason": "completed",
    "events": [
      {
        "seq": 1,
        "kind": "turn.started"
      },
      {
        "seq": 2,
        "kind": "usage"
      },
      {
        "seq": 3,
        "kind": "tool.started",
        "tool": "todo"
      },
      {
        "seq": 4,
        "kind": "tool.finished",
        "tool": "todo"
      },
      {
        "seq": 5,
        "kind": "text.delta",
        "text": "待办已记录。"
      },
      {
        "seq": 6,
        "kind": "usage"
      },
      {
        "seq": 7,
        "kind": "turn.finished",
        "stop": "completed"
      }
    ]
  }
}
