{
  "name": "a-da",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local AI coding agent: pure Rust core (agent_core) + Tauri desktop host + React UI",
  "scripts": {
    "typecheck": "npm --prefix tauri-ui run typecheck",
    "test": "cargo test --workspace",
    "test:core": "cargo test -p agent_core",
    "verify:archive": "bun tools/verify-archive.ts",
    "tauri:ui:dev": "npm --prefix tauri-ui run dev",
    "tauri:ui:build": "npm --prefix tauri-ui run build",
    "tauri:dev": "bunx @tauri-apps/cli dev",
    "tauri:build": "bunx @tauri-apps/cli build"
  }
}
